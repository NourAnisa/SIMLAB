    <title>Sertifikat {{ $pendaftaran->jadwal->skema->nama_skema }} - {{ $pendaftaran->user->name }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Times New Roman', Times, serif; font-size: 11pt; color: #000; background: #e2e8f0; }
        .page { width: 297mm; min-height: 210mm; margin: 0 auto; padding: 12mm 16mm; background: #fff; position: relative; overflow: hidden; }
        .border-outer { position: absolute; inset: 8px; border: 3px solid #1a3a5c; pointer-events: none; }
        .border-inner { position: absolute; inset: 13px; border: 1px solid #c8a84b; pointer-events: none; }
        .inner-content { position: relative; z-index: 1; }
        .kop { display: flex; align-items: center; gap: 12px; padding-bottom: 6px; border-bottom: 4px double #000; }
        .kop-logo { width: 72px; height: 72px; object-fit: contain; flex-shrink: 0; }
        .kop-teks { flex: 1; text-align: center; line-height: 1.25; }
        .kop-teks .k1 { font-size: 10pt; font-weight: bold; }
        .kop-teks .k2 { font-size: 14pt; font-weight: bold; text-transform: uppercase; }
        .kop-teks .k3 { font-size: 12pt; font-weight: bold; }
        .kop-teks .k4 { font-size: 8.5pt; margin-top: 2px; }
        .judul { text-align: center; margin: 8px 0 6px; }
        .judul .j1 { font-size: 18pt; font-weight: bold; text-transform: uppercase; letter-spacing: 6px; color: #1a3a5c; }
        .judul .j2 { font-size: 9pt; color: #475569; margin-top: 2px; }
        .divider { display: flex; align-items: center; gap: 10px; margin: 4px 0 8px; }
        .divider-line { flex: 1; height: 1.5px; background: linear-gradient(90deg, transparent, #c8a84b, transparent); }
        .divider-star { color: #c8a84b; font-size: 12pt; }
        .cert-body { display: flex; gap: 20px; align-items: flex-start; }
        .photo-col { flex-shrink: 0; width: 85px; text-align: center; }
        .foto { width: 75px; height: 95px; object-fit: cover; border: 2px solid #1a3a5c; display: block; margin: 0 auto; }
        .photo-placeholder { width: 75px; height: 95px; border: 2px solid #1a3a5c; display: flex; align-items: center; justify-content: center; background: #f0f4f8; margin: 0 auto; font-size: 26pt; font-weight: bold; color: #1a3a5c; }
        .foto-label { font-size: 7pt; color: #64748b; margin-top: 3px; }
        .iden-col { flex: 1; font-size: 10.5pt; color: #1e293b; line-height: 1.6; }
        .diberikan { font-size: 9.5pt; color: #475569; font-style: italic; }
        .recipient { font-size: 16pt; font-weight: bold; color: #1a3a5c; border-bottom: 1.5px solid #1a3a5c; display: inline-block; padding-bottom: 1px; margin: 4px 0 8px; }
        .tb { width: 100%; border-collapse: collapse; font-size: 10pt; }
        .tb td { padding: 2px 0; vertical-align: top; }
        .tb td:first-child { width: 110px; color: #475569; }
        .tb td:nth-child(2) { width: 10px; }
        .tb td:last-child { font-weight: 600; color: #0f172a; }
        .status-row { margin: 8px 0 4px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .sbadge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 14px; border-radius: 50px; font-size: 10.5pt; font-weight: bold; border: 2px solid; }
        .lulus { background: #f0fdf4; border-color: #16a34a; color: #15803d; }
        .tidak { background: #fff1f2; border-color: #ef4444; color: #be123c; }
        .nilai-box { display: inline-flex; align-items: center; gap: 8px; padding: 4px 14px; border-radius: 8px; border: 1.5px solid; }
        .keterangan { font-size: 9pt; color: #475569; font-style: italic; margin-top: 3px; }
        .legend { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
        .lg { padding: 3px 10px; border-radius: 6px; font-size: 7.5pt; font-weight: 700; border: 1px solid; }
        .ttd-col { flex-shrink: 0; min-width: 190px; text-align: center; }
        .ttd-col .tgl { font-size: 10.5pt; margin-bottom: 2px; }
        .ttd-col .jbt { font-weight: bold; font-size: 10.5pt; }
        .ttd-space { height: 85px; position: relative; width: 200px; margin: 0 auto; }
        .img-stemple { width: 85px; height: 85px; object-fit: contain; position: absolute; opacity: 0.75; left: 10px; top: 0; transform: rotate(-10deg); }
        .img-ttd { max-width: 130px; max-height: 60px; object-fit: contain; position: absolute; left: 50%; top: 50%; transform: translate(-40%, -50%); }
        .ttd-nama { font-weight: bold; text-decoration: underline; font-size: 11pt; margin-top: 2px; }
        .ttd-nip { font-size: 10pt; margin-top: 1px; }
        .wm { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-35deg); font-size: 64pt; font-weight: bold; color: rgba(239,68,68,.05); white-space: nowrap; pointer-events: none; z-index: 0; letter-spacing: 10px; }
        .print-bar { position: fixed; top: 0; left: 0; right: 0; background: #1e293b; color: #fff; padding: 9px 22px; display: flex; align-items: center; gap: 12px; z-index: 999; font-family: 'Segoe UI', sans-serif; font-size: 14px; }
        .print-bar span { flex: 1; }
        .btn-p { padding: 7px 20px; background: #4f46e5; color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
        .btn-b { padding: 7px 14px; background: transparent; color: #94a3b8; border: 1px solid #475569; border-radius: 6px; font-size: 14px; cursor: pointer; font-family: inherit; text-decoration: none; }
        @media print {
            .print-bar { display: none !important; }
            body { background: #fff; }
            .page { margin: 0; }
            @page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>
